# Local development: copy to .env.local. Everything is optional locally:
# without DATABASE_URL an embedded database is created in ./.data (with a sample
# Gaura Purnima event), without Stripe a simulated checkout is used, and without
# Resend emails are printed to the terminal.

ADMIN_EMAILS=you@example.com
