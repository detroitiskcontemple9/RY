# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# EMAIL_FROM=ISKCON Detroit Seva <seva@yourdomain.org>
# ZELLE_RECIPIENT=donations@iskcondetroit.com
# CRON_SECRET=any-long-random-string
